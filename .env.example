# Пароль для входа в админку (/#/admin). Обязателен.
ADMIN_PASSWORD=

# Telegram: токен бота от @BotFather и id чата, куда слать уведомления.
# Chat id бот сам пришлёт в ответ на /start после подключения вебхука.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# База: Upstash Redis (REST). На Vercel переменные добавит интеграция Upstash
# (подходят и её имена KV_REST_API_URL / KV_REST_API_TOKEN).
# Без них данные хранятся в памяти и пропадают: годится только для локальной разработки.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
